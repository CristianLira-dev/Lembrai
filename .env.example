# Supabase Auth: valores públicos do projeto Lembraí.
SUPABASE_URL=https://wbmmuttuyxhzdthunobb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_kgXnIob5m8hQjtMf4t1jtA_NE57qrDE
URL_FRONTEND=http://localhost:5173
CORS_ORIGENS=http://localhost:5173

# Copie as conexões do botão Connect do Supabase. Nunca versione a senha real.
# No Render, use o Session pooler (porta 5432), compatível com redes IPv4.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
# Use a conexão direta apenas onde IPv6 estiver disponível; caso contrário, repita o Session pooler.
DIRECT_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# JWT_SEGREDO assina somente o estado OAuth das integrações de calendário.
JWT_SEGREDO=substitua-por-um-segredo-aleatorio
USAR_BANCO_MEMORIA=false
USAR_FILAS_MEMORIA=true
MODO_WHATSAPP=simulado

# Usados pelo Docker Compose; para Vite local copie frontend/.env.example.
VITE_SUPABASE_URL=https://wbmmuttuyxhzdthunobb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kgXnIob5m8hQjtMf4t1jtA_NE57qrDE
